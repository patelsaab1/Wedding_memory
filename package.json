{
  "name": "wedding-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private wedding memory cloud and premium family gallery",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @wedding-memory/web",
    "dev:api": "npm run dev -w @wedding-memory/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @wedding-memory/web",
    "build:api": "npm run build -w @wedding-memory/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @wedding-memory/api",
    "typecheck": "npm run typecheck -w @wedding-memory/api",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
