# API server environment
# Copy to apps/api/.env and fill in values. Never commit real secrets.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# MongoDB — metadata only (never store media binaries here)
MONGODB_URI=mongodb://127.0.0.1:27017/wedding_memory

# Auth (JWT in HTTP-only cookies — never expose these to the frontend)
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Set true behind HTTPS in production
AUTH_COOKIE_SECURE=false

# Storage abstraction (Phase 04)
# Default provider for StorageManager: google_drive | r2
STORAGE_DEFAULT_PROVIDER=google_drive

# Google Drive — server-side only. Leave blank until provisioned.
# Never put these in apps/web or VITE_* variables.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# Photos folder id from the Drive URL (not a secret). Example path: Rohit & Roshni patel / Photos
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Live OAuth callback. Must match Google Cloud authorized redirect URIs.
# GOOGLE_DRIVE_REDIRECT_URI=https://wedding-memory-cdid.onrender.com/api/v1/storage/google/callback
# Super admin updates the refresh token from the Status page. Do not put the token in the web app.

# Cloudflare R2 — server-side only. Leave blank until provisioned.
# Never put these in apps/web or VITE_* variables.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_PUBLIC_BASE_URL=

LOG_LEVEL=info
